{
  "name": "site-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun x tsc -p tsconfig.json && bun x tsc-alias -p tsconfig.json",
    "start:bun": "bun dist/index.js",
    "db:seed": "bun src/db/seed/index.ts",
    "db:seed:nodrop": "bun src/db/seed/index.ts --no-drop",
    "db:import": "bun src/db/seed/import-questions.ts",
    "db:export-sql": "node src/db/seed/export-questions-sql.mjs"
  },
  "dependencies": {
    "@shared/shared-backend": "workspace:*",
    "@shared/shared-types": "workspace:*",
    "@fastify/cookie": "^11",
    "@fastify/cors": "^11",
    "@fastify/jwt": "^10",
    "@fastify/multipart": "^9",
    "@fastify/mysql": "^5.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@sentry/node": "^10.45.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5",
    "fastify-plugin": "^5.0.1",
    "mysql2": "^3.15.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "20",
    "bun-types": "^1.3.1",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.16",
    "typescript": "5"
  }
}
