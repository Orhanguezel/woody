PORT=8086
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app
DB_NAME=project_db
DB_ROOT_USER=app
DB_ROOT_PASSWORD=app
JWT_SECRET=project-jwt-secret-change-in-production
COOKIE_SECRET=project-cookie-secret-change-in-production
# development: localhost:3096 (admin panel) env.ts ile otomatik eklenir; production icin tum originleri yazin
CORS_ORIGIN=http://localhost:3034,http://localhost:3000,http://localhost:3077,http://127.0.0.1:3077,http://localhost:3096,http://127.0.0.1:3096
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./uploads
LOCAL_STORAGE_BASE_URL=/uploads
PUBLIC_URL=http://localhost:8086
FRONTEND_URL=http://localhost:3077
FEATURE_IYZICO_PAYMENT=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# PayTR (secret'lar BOS birakilir — deploy'da gercek degerler girilir; fallback yasak)
FEATURE_PAYTR_PAYMENT=false
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_ID=4f618a8d-6fdb-498c-898a-395d368b2193
# Ikinci admin (seed: 001_auth_schema.sql) — ayni ADMIN_PASSWORD ile hash uretilir
ADMIN2_EMAIL=atakan07sahin@gmail.com
ADMIN2_ID=b8e4c2a1-9f0d-4e7b-8c6d-5a4b3c2d1e0f
SENTRY_DSN=

# i18n — desteklenen diller (menu_items vb. localize API validation enum bu listeden olusur)
# NOT: z.enum modul yuklenince donar; yeni dil eklerken bu env + app_locales setting birlikte guncellenmeli
APP_LOCALES=tr,en,de,ar,fr,ru,es,it,nl,pt-br

# Tanitio icerik kaynagi kontrati (GET /api/v1/content-source/articles + /products).
# BOS BIRAKILIRSA uc acilmaz (503) — yedek/varsayilan anahtar YOK.
# Uretim: openssl rand -hex 32 ile uret, ayni degeri Tanitio tarafinda
# tenant secret content_source/api_key olarak sakla.
CONTENT_SOURCE_API_KEY=
