# Bu dosyayi `.secrets/credentials.env` olarak kopyalayip doldurun.
# .secrets/ gitignore'dadir — sirlar repoya commit edilmez.
#
#   mkdir -p .secrets && cp deploy/credentials.env.example .secrets/credentials.env

# ─── VPS erisimi (zorunlu) ───────────────────────────────────────────────────────
VPS_USER=root
VPS_HOST=
SSH_KEY=~/.ssh/id_ed25519

# ─── Yol / runtime (opsiyonel) ───────────────────────────────────────────────────
# Varsayilan: /var/www/<slug>   (slug proje.json'dan)
DEPLOY_PATH=
# VPS'te bun yolu (varsayilan /usr/local/bin/bun)
BUN_BIN=/usr/local/bin/bun

# ─── Production domainler (nginx + Next.js public env) ────────────────────────────
# DNS hazir olunca doldurun. Bos ise nginx template'i elle duzenlenir.
DOMAIN_FRONTEND=
DOMAIN_ADMIN=
DOMAIN_API=
