{
  "rootLayout": {
    "titleDefault": "{{appName}} — Dijital öğrenme ve içerik",
    "titleTemplate": "%s | {{appName}}"
  },
  "brand": {
    "appName": "AppName",
    "taglineTr": "Nötr web uygulaması şablonu",
    "taglineEn": "Neutral web application template",
    "themeColor": "#15803d",
    "themeColorDark": "#052e16",
    "wordMarkLine1": "{{appName}}",
    "wordMarkLine2": "",
    "shortName": "{{appName}}",
    "copyrightHolder": "{{appName}}",
    "defaultLogoAlt": "Site logo"
  },
  "site": {
    "originFallback": "http://localhost:3077",
    "apiBaseFallback": "http://127.0.0.1:8086/api/v1"
  },
  "i18n": {
    "defaultLocale": "tr"
  },
  "seo": {
    "global": {
      "site_name": "{{appName}}",
      "title_default": "{{appName}} — Nötr web uygulaması şablonu",
      "title_template": "%s | {{appName}}",
      "description": "{{appName}} için nötr frontend şablonu.",
      "open_graph": {
        "type": "website",
        "images": [
          "/img/og-default.jpg"
        ]
      },
      "twitter": {
        "card": "summary_large_image",
        "site": "",
        "creator": ""
      },
      "robots": {
        "noindex": false,
        "index": true,
        "follow": true
      }
    },
    "siteMetaByLocale": {
      "tr": {
        "title": "{{appName}} — Dijital öğrenme ve içerik platformu",
        "description": "Konu bazlı içerikler, ilerleme takibi ve güvenilir kaynaklarla öğrenmeyi sürdürün.",
        "keywords": "{{appName}}, eğitim, dijital öğrenme, içerik, online"
      },
      "en": {
        "title": "{{appName}} — Digital learning and content",
        "description": "Structured topics, progress tracking, and trusted educational content.",
        "keywords": "{{appName}}, education, digital learning, online content"
      },
      "de": {
        "title": "{{appName}} — Digitales Lernen und Inhalte",
        "description": "Themenbasierte Inhalte, Fortschritt und vertrauenswürdige Lernressourcen.",
        "keywords": "{{appName}}, bildung, digitales lernen, online-inhalte"
      }
    },
    "localeDescriptionFallback": {
      "tr": "{{appName}} — Eğitim içerikleri ve güvenilir dijital öğrenme deneyimi.",
      "en": "{{appName}} — Educational content and a trusted digital learning experience.",
      "de": "{{appName}} — Bildungsinhalte und ein vertrauenswürdiges digitales Lernerlebnis."
    },
    "htmlMetaDescriptionByLocale": {
      "tr": "{{appName}} — Dijital öğrenme, içerik ve kullanıcı odaklı deneyim.",
      "en": "{{appName}} — Digital learning, content, and a user-focused experience.",
      "de": "{{appName}} — Digitales Lernen, Inhalte und nutzerzentrierte Erfahrung."
    }
  },
  "jsonLd": {
    "organizationDescription": {
      "tr": "Dijital öğrenme ve içerik platformu.",
      "en": "Digital learning and content platform.",
      "de": "Digitale Lern- und Inhaltsplattform."
    },
    "placeholderSameAs": []
  },
  "editorial": {
    "teamNameTemplate": "{{appName}} Editorial Team"
  },
  "manifest": {
    "nameKey": "manifest.name",
    "shortNameKey": "manifest.shortName",
    "descriptionKey": "manifest.description",
    "name": "{{appName}}",
    "shortName": "{{appName}}",
    "description": "Dijital öğrenme ve içerik platformu.",
    "startLocalePath": "/tr"
  },
