{
  "name": "woody-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Woody monorepo — backend + admin_panel + frontend; ortak @shared/* paketleri packages/ altinda (ayri repo).",
  "workspaces": [
    "packages/*",
    "backend",
    "admin_panel",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "cd backend && bun run dev",
    "dev:admin": "cd admin_panel && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "build:backend": "cd backend && bun run build",
    "seed": "cd backend && bun run db:seed",
    "seed:nodrop": "cd backend && bun run db:seed:nodrop"
  }
}
